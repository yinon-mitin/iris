# Iris configuration. `make init` copies this to .env; fill in the first block.
# Every option is described in docs/INSTALL.md

# --- required ---
# https://my.telegram.org -> API development tools
APP_ID=
APP_HASH=
# @BotFather -> /newbot
BOT_TOKEN=
# your Telegram ID (ask @userinfobot), comma-separated for several owners
OWNER=
# allowed users, comma-separated (owners are always allowed)
AUTHORIZED_USER=

# --- defaults, usually no need to change ---
WORKERS=16
DB_DSN=sqlite:////data/iris.db
# empty = in-memory cache, no separate Redis container
REDIS_HOST=
# how often to check for a new yt-dlp nightly, seconds
YTDLP_UPDATE_INTERVAL=86400
ENABLE_FFMPEG=False
AUDIO_FORMAT=
M3U8_SUPPORT=False
ENABLE_ARIA2=False
TMPFILE_PATH=
RATE_LIMIT=120
CAPTION_URL_LENGTH_LIMIT=150

# paid mode from the upstream project, not needed for a private bot
ENABLE_VIP=False
PROVIDER_TOKEN=
FREE_DOWNLOAD=5
